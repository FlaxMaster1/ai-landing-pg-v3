---
import type { Asset } from "@entities/index";
interface Props { asset: Asset; loading?: "eager" | "lazy"; class?: string; }
const { asset, loading = "lazy", class: className } = Astro.props;
const focalPosition = asset.focalPoint ? `${asset.focalPoint.x * 100}% ${asset.focalPoint.y * 100}%` : undefined;
---
<figure class:list={["u-responsive-media", className]}>
  <img src={asset.src} alt={asset.alt} {loading} decoding="async" style={focalPosition ? `object-position: ${focalPosition}` : undefined} />
  {(asset.caption || asset.credit) && <figcaption>{asset.caption}{asset.credit && <small>{asset.credit}</small>}</figcaption>}
</figure>
