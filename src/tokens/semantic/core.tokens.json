{
  "$description": "Semantic aliases consumed by shared framework styles.",
  "surface": {
    "page": { "$type": "color", "$value": "{color.neutral.50}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.100}" },
    "brandPrimary": { "$type": "color", "$value": "{color.blue.700}" },
    "brandAccent": { "$type": "color", "$value": "{color.red.700}" },
    "inverse": { "$type": "color", "$value": "{color.blue.700}" }
  },
  "text": {
    "default": { "$type": "color", "$value": "{color.neutral.950}" },
    "muted": { "$type": "color", "$value": "{color.neutral.600}" },
    "link": { "$type": "color", "$value": "{color.red.700}" },
    "inverse": { "$type": "color", "$value": "{color.neutral.0}" }
  },
  "focus": {
    "color": { "$type": "color", "$value": "{color.blue.500}" },
    "width": { "$type": "dimension", "$value": "0.1875rem" }
  },
  "layout": {
    "gutter": { "$type": "dimension", "$value": "0.9375rem" },
    "section": { "$type": "dimension", "$value": "clamp(3.125rem, 6vw, 5rem)" },
    "sectionLarge": { "$type": "dimension", "$value": "clamp(4rem, 8vw, 6.25rem)" }
  },
  "type": {
    "display": { "$type": "dimension", "$value": "clamp(2.5rem, 5vw, 3.125rem)" },
    "heading": { "$type": "dimension", "$value": "clamp(2rem, 4vw, 2.375rem)" },
    "subheading": { "$type": "dimension", "$value": "clamp(1.625rem, 3vw, 1.875rem)" },
    "lead": { "$type": "dimension", "$value": "1.125rem" },
    "stat": { "$type": "dimension", "$value": "clamp(2.5rem, 6vw, 4.5rem)" }
  }
}
