{
  "$description": "Primitive type, space, size, border, elevation, motion, and breakpoint values.",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Acumin Pro", "Arial", "Helvetica", "sans-serif"] },
      "sansBold": { "$type": "fontFamily", "$value": ["Acumin Pro Bold", "Arial", "Helvetica", "sans-serif"] },
      "sansBlack": { "$type": "fontFamily", "$value": ["Acumin Pro Black", "Arial", "Helvetica", "sans-serif"] },
      "sansCondensed": { "$type": "fontFamily", "$value": ["Acumin Pro Condensed", "Arial Narrow", "Arial", "sans-serif"] },
      "sansCondensedBold": { "$type": "fontFamily", "$value": ["Acumin Pro Condensed Bold", "Arial Narrow", "Arial", "sans-serif"] },
      "sansCondensedBlack": { "$type": "fontFamily", "$value": ["Acumin Pro Condensed Black", "Arial Narrow", "Arial", "sans-serif"] },
      "serif": { "$type": "fontFamily", "$value": ["Minion Pro", "Georgia", "Times New Roman", "serif"] },
      "serifBold": { "$type": "fontFamily", "$value": ["Minion Pro Bold", "Georgia", "Times New Roman", "serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "size": {
    "content": { "$type": "dimension", "$value": "76.5625rem" },
    "text": { "$type": "dimension", "$value": "48rem" },
    "touch": { "$type": "dimension", "$value": "2.75rem" }
  },
  "border": {
    "thin": { "$type": "dimension", "$value": "0.0625rem" },
    "thick": { "$type": "dimension", "$value": "0.25rem" },
    "radius": { "$type": "dimension", "$value": "0rem" }
  },
  "elevation": {
    "raised": { "$type": "shadow", "$value": { "color": "#111b271f", "offsetX": "0rem", "offsetY": "0.125rem", "blur": "0.375rem", "spread": "0rem" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "220ms" }
  },
  "breakpoint": {
    "navigation": { "$type": "dimension", "$value": "62rem" },
    "wide": { "$type": "dimension", "$value": "62rem" }
  }
}
