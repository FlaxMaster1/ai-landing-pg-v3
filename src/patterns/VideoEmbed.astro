---
import Heading from "@components/Heading.astro";
import VideoFrame from "@components/VideoFrame.astro";
import Container from "@utilities/Container.astro";
interface Props { id: string; eyebrow?: string; heading?: string; text?: string; provider?: "youtube" | "vimeo"; videoId: string; videoHash?: string; title: string; aspectRatio?: string; sourceAspectRatio?: string; autoplay?: boolean; controls?: boolean; veilColor?: string; }
const { id, eyebrow, heading, text, ...video } = Astro.props;
---
<section id={id} class="p-section p-video-embed" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container>
    <div class="p-video-embed__content">
      {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
      {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
      {text && <p>{text}</p>}
    </div>
    <VideoFrame {...video} />
  </Container>
</section>
