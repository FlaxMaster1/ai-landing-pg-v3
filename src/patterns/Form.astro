---
import Button from "@components/Button.astro";
import FormControl from "@components/FormControl.astro";
import Heading from "@components/Heading.astro";
import Message from "@components/Message.astro";
import Container from "@utilities/Container.astro";
interface Field { id: string; label: string; type: "text" | "email" | "textarea"; required?: boolean; hint?: string; }
interface Props { id: string; heading: string; text?: string; submitLabel: string; fields: Field[]; successMessage: string; provider: string; }
const { id, heading, text, submitLabel, fields, successMessage, provider } = Astro.props;
---
<section id={id} class="p-section" aria-labelledby={`${id}-heading`}>
  <Container>
    <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>
    {text && <p>{text}</p>}
    <form class="p-form" data-prototype-form data-provider={provider}>
      {fields.map((field) => <FormControl {...field} id={`${id}-${field.id}`} />)}
      <Button type="submit">{submitLabel}</Button>
      <div hidden data-form-result><Message tone="success" role="status">{successMessage}</Message></div>
    </form>
  </Container>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>("[data-prototype-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const result = form.querySelector<HTMLElement>("[data-form-result]");
      if (result) {
        result.hidden = false;
        result.querySelector<HTMLElement>("[role='status']")?.focus();
      }
    });
  });
</script>
