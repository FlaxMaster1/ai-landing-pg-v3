---
import Disclosure from "@components/Disclosure.astro";
import Heading from "@components/Heading.astro";
import Container from "@utilities/Container.astro";
interface Props { id: string; heading?: string; items: Array<{ question: string; answer: string }>; }
const { id, heading, items } = Astro.props;
---
<section id={id} class="p-section" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container>
    {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
    <div class="p-faq">{items.map((item) => <Disclosure summary={item.question}><p>{item.answer}</p></Disclosure>)}</div>
  </Container>
</section>
