---
import Heading from "@components/Heading.astro";
import Container from "@utilities/Container.astro";
interface Props { id: string; heading?: string; orientation?: "horizontal" | "vertical"; items: Array<{ label: string; content: string }>; }
const { id, heading, orientation = "horizontal", items } = Astro.props;
---
<section id={id} class="p-section" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container>
    {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
    <div class:list={["p-tabs", `p-tabs--${orientation}`]} data-tabs>
      <div role="tablist" aria-orientation={orientation}>
        {items.map((item, index) => (
          <button id={`${id}-tab-${index}`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`${id}-panel-${index}`} tabindex={index === 0 ? 0 : -1}>{item.label}</button>
        ))}
      </div>
      {items.map((item, index) => (
        <div id={`${id}-panel-${index}`} role="tabpanel" aria-labelledby={`${id}-tab-${index}`} hidden={index !== 0} tabindex="0"><p>{item.content}</p></div>
      ))}
    </div>
  </Container>
</section>
<script>
  const activate = (tabs: HTMLElement[], panels: HTMLElement[], index: number) => {
    tabs.forEach((tab, current) => {
      tab.setAttribute("aria-selected", String(current === index));
      tab.tabIndex = current === index ? 0 : -1;
      panels[current]!.hidden = current !== index;
    });
    tabs[index]?.focus();
  };
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>("[role='tab']")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role='tabpanel']")];
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tabs, panels, index));
      tab.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : index + (["ArrowRight", "ArrowDown"].includes(event.key) ? 1 : -1);
        activate(tabs, panels, (next + tabs.length) % tabs.length);
      });
    });
  });
</script>
