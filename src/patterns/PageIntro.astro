---
import type { Action } from "@entities/index";
import Button from "@components/Button.astro";
import Heading from "@components/Heading.astro";
import Container from "@utilities/Container.astro";
interface Props { id: string; eyebrow?: string; heading?: string; text: string; actions?: Action[]; }
const { id, eyebrow, heading, text, actions = [] } = Astro.props;
---
<section id={id} class="p-page-intro" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container size="text">
    {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
    {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
    <p class="p-page-intro__lead">{text}</p>
    {actions.length > 0 && <div class="u-layout--cluster">{actions.map((action) => <Button href={action.url} variant={action.type} external={action.external}>{action.label}</Button>)}</div>}
  </Container>
</section>
