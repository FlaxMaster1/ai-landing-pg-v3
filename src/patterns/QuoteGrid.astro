---
import type { Asset } from "@entities/index";
import Heading from "@components/Heading.astro";
import QuoteCard from "@components/QuoteCard.astro";
import Container from "@utilities/Container.astro";
interface QuoteItem { name: string; title?: string; quote: string; image?: Asset; }
interface Props { id: string; eyebrow?: string; heading?: string; items: QuoteItem[]; }
const { id, eyebrow, heading, items } = Astro.props;
---
<section id={id} class="p-section" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container>
    {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
    {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
    <div class="p-quote-grid">
      {items.map((item) => <QuoteCard {...item} />)}
    </div>
  </Container>
</section>
