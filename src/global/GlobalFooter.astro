---
import type { LoadedSite } from "@rendering/site-loader";
interface Props { site: LoadedSite; }
const { site } = Astro.props;
---
<footer class="g-global-footer" aria-label={site.config.ui.footerLabel}>
  <div class="u-container">
    <details class="g-global-footer__additional">
      <summary>{site.config.ui.footerAdditionalLinks}</summary>
      {site.footer.additionalLinks.length > 0 && <nav aria-label="Additional links"><ul role="list">{site.footer.additionalLinks.map((item) => <li><a href={item.url}>{item.label}</a></li>)}</ul></nav>}
      <div class="g-global-footer__groups">
        {site.footer.institutionalGroups.map((group) => <section><h2>{group.heading}</h2><ul role="list">{group.links.map((item) => <li><a href={item.url} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>{item.label}</a></li>)}</ul></section>)}
      </div>
    </details>
    {site.config.institutionalBrand && (
      <a class="g-global-footer__brand" href={site.config.institutionalBrand.homeUrl}>
        <img src={site.config.institutionalBrand.footerLogo.src} alt={site.config.institutionalBrand.footerLogo.alt} width="147" height="41" />
      </a>
    )}
    <div class="g-global-footer__legal">
      <p>{site.config.prototypeTitle}</p>
      <ul role="list">{site.footer.legal.map((item) => <li><a href={item.url}>{item.label}</a></li>)}</ul>
    </div>
  </div>
</footer>
