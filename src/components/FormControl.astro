---
interface Props {
  id: string;
  label: string;
  type: "text" | "email" | "textarea";
  required?: boolean;
  hint?: string;
}
const { id, label, type, required = false, hint } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---
<div class="c-form-control">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {hint && <p id={hintId} class="c-form-control__hint">{hint}</p>}
  {type === "textarea"
    ? <textarea {id} name={id} {required} aria-describedby={hintId}></textarea>
    : <input {id} name={id} {type} {required} aria-describedby={hintId} />}
</div>
