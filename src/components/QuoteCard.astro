---
import type { Asset } from "@entities/index";
import Image from "./Image.astro";
interface Props { name: string; title?: string; quote: string; image?: Asset; }
const { name, title, quote, image } = Astro.props;
---
<figure class="c-quote-card">
  <div class="c-quote-card__header">
    {image && <Image asset={image} class="c-quote-card__media" />}
    <figcaption>
      <p class="c-quote-card__name">{name}</p>
      {title && <p class="c-quote-card__title">{title}</p>}
    </figcaption>
  </div>
  <blockquote><p>&ldquo;{quote}&rdquo;</p></blockquote>
</figure>
