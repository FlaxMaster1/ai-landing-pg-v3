---
import type { Asset, Story } from "@entities/index";
import Card from "./Card.astro";
interface Props { story: Story; image?: Asset; variant?: "editorial" | "compact" | "feature" | "media-led"; }
const { story, image, variant = "editorial" } = Astro.props;
const eyebrow = [story.topic, story.date ? new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${story.date}T00:00:00Z`)) : undefined].filter(Boolean).join(" · ");
const contentCategory = story.topic
  ?.toLowerCase()
  .replace(/&/g, "and")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
---
<Card title={story.title} description={story.excerpt} {image} eyebrow={eyebrow || undefined} action={{ label: "Read story", url: story.url }} {contentCategory} {variant} />
