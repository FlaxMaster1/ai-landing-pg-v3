---
interface Props { href: string; external?: boolean; class?: string; }
const { href, external = false, class: className } = Astro.props;
---
<a {href} class={className} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
  <slot />{external && <span class="u-screen-reader"> (opens in a new tab)</span>}
</a>
