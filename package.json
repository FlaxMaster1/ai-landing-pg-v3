{
  "name": "wharton-web-prototype-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "predev": "npm run generate:tokens",
    "dev": "astro dev",
    "predev:reference": "npm run generate:tokens",
    "dev:reference": "SITE=reference astro dev",
    "prebuild": "npm run generate:tokens",
    "build": "astro build",
    "prebuild:reference": "npm run generate:tokens",
    "build:reference": "SITE=reference astro build",
    "preview": "node scripts/serve-dist.mjs",
    "preview:astro": "astro preview",
    "check": "npm run check:tokens && astro check",
    "content:validate": "vitest run tests/unit/content-validation.test.ts",
    "audit:build": "node scripts/audit-build.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npm run build:reference && playwright test",
    "test:e2e:built": "playwright test",
    "test:a11y": "npm run build:reference && playwright test tests/accessibility",
    "test:visual": "npm run build:reference && playwright test tests/visual",
    "test:visual:update": "npm run build:reference && playwright test tests/visual --update-snapshots",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate": "npm run content:validate && npm run check && npm run test:unit && npm run build:reference && npm run audit:build && npm run test:e2e:built"
  },
  "dependencies": {
    "astro": "7.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
